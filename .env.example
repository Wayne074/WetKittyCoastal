# Storefront commerce
PUBLIC_SITE_URL=https://wetkittycoastal.com
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CART_SIGNING_SECRET=

# Launch shipping defaults: $5.99, free at $100
STRIPE_FLAT_SHIPPING_CENTS=599
STRIPE_FREE_SHIPPING_THRESHOLD_CENTS=10000

# Enable only after Stripe Tax is activated in the Stripe dashboard
STRIPE_AUTOMATIC_TAX=false
